VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://192.168.1.200:5000
VITE_API_IIS_URL=http://192.168.1.200:5000/api
VITE_APP_BASE=/
# Vercel production:
# VITE_API_BASE_URL=https://posapi-cloud.onrender.com/api
# Modes:
# npm run dev:local5012  -> uses .env.local5012 (http://localhost:5012)
# npm run dev:iis5000    -> uses .env.iis5000   (http://localhost:5000)
# npm run build:iis      -> uses .env.iis        (deploy under /POS + API on :5000)
# npm run build:iisroot  -> uses .env.iisroot    (deploy under / + API on :5000)
