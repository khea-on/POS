{
  "name": "pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local5012": "vite --mode local5012",
    "dev:iis5000": "vite --mode iis5000",
    "dev:iisroot": "vite --mode iisroot",
    "dev:mobile": "vite --mode mobile",
    "build:iis": "vite build --mode iis",
    "build:iisroot": "vite build --mode iisroot",
    "build:mobile": "vite build --mode mobile",
    "build": "vite build",
    "mobile:sync": "npm run build:mobile && npx cap sync android",
    "mobile:copy": "npm run build:mobile && npx cap copy android",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:apk": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-mobile-apk.ps1",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.1",
    "@capacitor/cli": "^7.6.1",
    "@capacitor/core": "^7.6.1",
    "axios": "^1.15.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^5.4.19"
  }
}
